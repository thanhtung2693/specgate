# syntax=docker/dockerfile:1.27.1
#
# Agents container. The default CMD runs the LangGraph dev server (graph + HTTP
# app from langgraph.json). Deployments may override the command to serve only
# the FastAPI webapp via uvicorn (the production environment is on PATH). Set
# LANGSMITH_API_KEY for optional tracing.

FROM python:3.13-slim-trixie
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="SpecGate Agents" \
      org.opencontainers.image.source="https://github.com/thanhtung2693/specgate" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.specgate.managed="true" \
      org.specgate.component="agents"

WORKDIR /deps/agents

COPY app/agents/pyproject.toml app/agents/uv.lock app/agents/README.md ./
# Mount the build tool rather than shipping it. Use the same frozen production
# environment as the appliance; installing the CLI again would resolve outside
# the project's lockfile.
RUN --mount=from=ghcr.io/astral-sh/uv:0.12.23,source=/uv,target=/usr/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY app/agents/ ./
RUN --mount=from=ghcr.io/astral-sh/uv:0.12.23,source=/uv,target=/usr/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

ENV PATH=/deps/agents/.venv/bin:$PATH

EXPOSE 8000

CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "8000", "--no-browser"]
