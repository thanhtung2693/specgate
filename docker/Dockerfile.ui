# syntax=docker/dockerfile:1.27.1

# --- deps ---
FROM node:26-alpine AS deps
WORKDIR /app

COPY app/ui/package.json app/ui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# --- build ---
FROM deps AS build

# BUILD_MODE picks which .env.<mode> file Vite loads at build time. Defaults to
# production; choose another mode explicitly with --build-arg BUILD_MODE=<mode>.
#
# VITE_* values default to the same-origin appliance proxy paths below. Declare
# them here so Docker Compose (or CI) can override via build-arg. Shell env
# takes priority over .env files
# in Vite's resolution order. Add new VITE_* vars by: (1) ARG + ENV here,
# (2) Compose build.args, (3) app/ui/.env.<mode> for non-Docker builds.
ARG BUILD_MODE=production
ARG VITE_DOC_REGISTRY_URL=/api/doc-registry
ARG VITE_LANGGRAPH_API_URL=/api/agents
ENV VITE_DOC_REGISTRY_URL=$VITE_DOC_REGISTRY_URL
ENV VITE_LANGGRAPH_API_URL=$VITE_LANGGRAPH_API_URL

COPY app/ui/ .
RUN npm run build -- --mode ${BUILD_MODE}

# --- static SPA ---
# Keep this as the final stage so plain `docker build -f docker/Dockerfile.ui .`
# produces the production image.
FROM nginx:1.30.5-alpine AS runtime
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="SpecGate UI" \
      org.opencontainers.image.source="https://github.com/thanhtung2693/specgate" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.specgate.managed="true" \
      org.specgate.component="ui"
COPY --from=build /app/dist /usr/share/nginx/html
COPY app/ui/docker/nginx-default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
